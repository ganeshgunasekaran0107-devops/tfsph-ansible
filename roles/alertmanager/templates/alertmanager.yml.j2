---
global:
  resolve_timeout: 5m

  smtp_smarthost: "smtp.gmail.com:587"
  smtp_from: "{{ alertmanager_gmail_address }}"
  smtp_auth_username: "{{ alertmanager_gmail_address }}"
  smtp_auth_password: "{{ gmail_secret.stdout }}"
  smtp_require_tls: true
  

route:
  receiver: "gmail-alerts"

  group_by:
    - alertname
    - instance

  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: "gmail-alerts"

    email_configs:
      - to: "{{ alertmanager_gmail_address }}"
        send_resolved: true